<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Voxsign1.Views.MainPage"
             BackgroundColor="#0F172A"
             Title="Accueil">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Bonjour Daniela" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="VoxSign à votre rythme" FontSize="14" TextColor="#38BDF8"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Profil" BackgroundColor="#1E293B" TextColor="White" CornerRadius="20"/>
            </Grid>

            <Image Source="voxsign_hero.jpg" HeightRequest="140" Aspect="AspectFill"/>

            <Label Text="Comment communiquer ?" FontSize="16" FontAttributes="Bold" TextColor="White" Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1E293B" BorderColor="Transparent" CornerRadius="12">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToTextToSignCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="T → 🧏" FontSize="20" TextColor="#38BDF8"/>
                        <Label Text="Texte → signes" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Écrire, illustrer et faire lire" FontSize="11" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1E293B" BorderColor="Transparent" CornerRadius="12">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToVoiceToTextCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🎙️" FontSize="20"/>
                        <Label Text="Voix → texte" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Lire ce que l'on vous dit" FontSize="11" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1E293B" BorderColor="Transparent" CornerRadius="12">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToUsefulPhrasesCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💬" FontSize="20"/>
                        <Label Text="Phrases utiles" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Des mots pour le quotidien" FontSize="11" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#1E293B" BorderColor="Transparent" CornerRadius="12">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToChatCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="👥" FontSize="20"/>
                        <Label Text="Échanger" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Un espace avec vos proches" FontSize="11" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="12" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Vos essentiels, même sans réseau" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="2 packs téléchargés" FontSize="12" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Gérer" Command="{Binding GoToOfflinePacksCommand}" BackgroundColor="#2563EB" TextColor="White"/>
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>